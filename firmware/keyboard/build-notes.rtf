\f0\b\fs36 \cf0 keyboards/apple/bookmac_prototype/rules.mk\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Start without VIA to prove the base keymap. You can re-enable VIA later (see \'a77).\
\pard\pardeftab720\partightenfactor0

\f1\fs26 \cf0 \
MCU = atmega32u4\
BOOTLOADER = atmel-dfu\
LTO_ENABLE = yes\
VIA_ENABLE = no\
DYNAMIC_KEYMAP_ENABLE = no\
CONSOLE_ENABLE = yes\
BOOTMAGIC_ENABLE = yes\
\pard\pardeftab720\sa298\partightenfactor0

