\f2\fs24 \cf0 If you ever want 
\f0\b toggle FN
\f2\b0 , change 
\f1\fs26 MO(_FN)
\f2\fs24  to 
\f1\fs26 TG(_FN)
\f2\fs24 ; to return to base, hit it again.\
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 4) Build\
\pard\pardeftab720\partightenfactor0

\f1\b0\fs26 \cf0 \
cd ~/qmk_firmware\
qmk clean\
qmk compile -kb apple/bookmac_prototype -km via\
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 5) Flash (manual DFU path is most reliable on Mac)\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls2\ilvl0
\fs24 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	1	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Enter DFU
\f2\b0 : double-tap the reset on your controller.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls2\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	2	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Flash:\
\pard\pardeftab720\partightenfactor0

\f1\fs26 \cf0 \
cd ~/qmk_firmware\
sudo dfu-programmer atmega32u4 erase --force\
sudo dfu-programmer atmega32u4 flash .build/apple_bookmac_prototype_via.hex\
sudo dfu-programmer atmega32u4 reset\
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 6) One-time EEPROM clear (Bootmagic Lite)\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Do this 
\f0\b once
\f2\b0  so runtime matches the new keymap:\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls3\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	1	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Unplug the keyboard.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls3\ilvl0
\f0\b \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	2	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Hold Esc (top-left)
\f2\b0 .\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls3\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	3	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Plug in while holding ~2 seconds, then release.\
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 7) (Optional) Re-enable VIA for live remaps\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 If you want VIA after you\'92ve proven the base keymap:\
\pard\pardeftab720\partightenfactor0

\f1\fs26 \cf0 \
# keyboards/apple/bookmac_prototype/rules.mk\
VIA_ENABLE = yes\
DYNAMIC_KEYMAP_ENABLE = yes\
\pard\pardeftab720\sa240\partightenfactor0

\f2\fs24 \cf0 Rebuild & flash (steps \'a74\'965), then in 
\f0\b VIA \uc0\u8594  Settings \u8594  Restore Defaults
\f2\b0  once and 
\f0\b Save
\f2\b0  your layout.\
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 8) Verify / useful checks\
\pard\pardeftab720\partightenfactor0

\f1\b0\fs26 \cf0 \
# Confirm JSON is valid\
python3 -m json.tool ~/qmk_firmware/keyboards/apple/bookmac_prototype/keyboard.json >/dev/null && echo "keyboard.json OK"\
\
# See what layout macro QMK generated from your JSON\
grep -n 'define LAYOUT_' .build/obj_apple_bookmac_prototype_via/src/default_keyboard.h | sed -n '1p'\
\
# Optional console (requires CONSOLE_ENABLE = yes)\
qmk console\
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 9) Backup working state (nice to have)\
\pard\pardeftab720\partightenfactor0

\f1\b0\fs26 \cf0 \
cd ~/qmk_firmware/keyboards/apple/bookmac_prototype\
mkdir -p .backup\
tar -czf .backup/working-$(date +%Y%m%d-%H%M).tgz .\
echo "Backup at: $(pwd)/.backup"\
\pard\pardeftab720\partightenfactor0

