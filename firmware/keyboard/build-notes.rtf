#pragma once\
#define DEBOUNCE 5\
\
// Bootmagic Lite "top-left" == row 0, col 0 (Esc)\
// Hold Esc *while plugging in* to clear EEPROM once.\
#define BOOTMAGIC_LITE_ROW    0\
#define BOOTMAGIC_LITE_COLUMN 0\
