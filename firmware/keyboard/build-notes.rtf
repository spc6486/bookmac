\f0\b\fs48 \cf0 1) Fresh QMK checkout\
\pard\pardeftab720\partightenfactor0

\f1\b0\fs26 \cf0 \
# Clone/initialize QMK (to ~/qmk_firmware)\
qmk setup -y\
\
# Quick environment check\
qmk doctor\
\pard\pardeftab720\sa321\partightenfactor0

