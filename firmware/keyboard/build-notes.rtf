\outl0\strokewidth0 \strokec2 0) Prereqs (macOS)\
\pard\pardeftab720\partightenfactor0

\f1\b0\fs26 \cf0 \
# Toolchain\
brew install python@3.12 dfu-programmer osx-cross/avr/avr-gcc@9\
\
# One-time virtualenv for QMK CLI (keeps Homebrew Python clean)\
python3.12 -m venv ~/.qmk-venv\
source ~/.qmk-venv/bin/activate\
pip install -U pip qmk\
